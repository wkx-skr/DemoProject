{
  "source": {
    "persona_state": "%USERPROFILE%/.dsh/douyin-browser/memory/persona/state.json",
    "shared_db": "%USERPROFILE%/.dsh/douyin-browser/memory/shared.sqlite"
  },
  "state_db": "%USERPROFILE%/.dsh/douyin-browser/control/livingmemory-sync.sqlite3",
  "attributes": {
    "enabled": true,
    "state_db": "%USERPROFILE%/.dsh/douyin-browser/control/yiyi-attributes.sqlite3",
    "panel_path": "attribute-panel.html"
  },
  "ssh": {
    "host": "your-server.example",
    "user": "your-ssh-user",
    "key_path": "%USERPROFILE%/.ssh/your_existing_key",
    "remote_port": 6185,
    "astrbot_root": "/opt/AstrBot"
  },
  "destination": {
    "auth_mode": "ssh-admin-session",
    "session_id": "livingmemory:global",
    "persona_id": "default",
    "adapter_id": "aiocqhttp"
  },
  "timeout": 45
}
